{
  "name": "@mugen/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Mugen Verifiable Inference Network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsc --watch",
    "test": "jest --runInBand --config jest.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "e2e": "tsx src/e2e_verify.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zkml",
    "zk",
    "inference",
    "verifiable",
    "mugen",
    "web3"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "1.13.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}