# .env — Mungen deploy config
# Copy this to contracts/.env and fill in values
# NEVER commit this file — add .env to .gitignore

PRIVATE_KEY=0x...

# RPC URLs
RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Explorer API keys
ETHERSCAN_API_KEY=...
BASESCAN_API_KEY=...
