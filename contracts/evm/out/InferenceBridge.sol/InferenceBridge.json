params\":{\"inferenceId\":\"Unique job identifier \\u2014 keccak256(jobId) from gateway.\",\"modelHash\":\"keccak256(modelName + modelVersion) \\u2014 must match                     what the contract was compiled against.\",\"proof\":\"Raw proof bytes from EZKL.\",\"publicInputs\":\"Public inputs array (model output, input hash, etc).\"}},\"withdraw()\":{\"details\":\"Allow owner to rescue any ETH accidentally sent to this contract.\"}},\"stateVariables\":{\"cairoDest\":{\"details\":\"InferenceVerifier.cairo contract address as uint256 (felt252).\"},\"cairoSelector\":{\"details\":\"keccak256(\\\"consume_inference_result\\\") truncated to felt252.      Compute off-chain:        python3 -c \\\"from starkware.cairo.lang.compiler.identifier_definition import *;                     from starkware.crypto.signature.fast_pedersen_hash import pedersen_hash;                     print(hex(get_selector_from_name('consume_inference_result')))\\\"\"},\"verified\":{\"details\":\"Prevents replaying the same inferenceId twice.\"}},\"title\":\"InferenceBridge\",\"version\":1},\"userdoc\":{\"events\":{\"InferenceVerified(bytes32,address,bytes32,uint256)\":{\"notice\":\"Emitted when a proof passes KZG verification.\"},\"MessageSentToStarkNet(bytes32,bytes32,uint256)\":{\"notice\":\"Emitted when the L1\\u2192L2 message is dispatched to StarkNet core.\"}},\"kind\":\"user\",\"methods\":{\"isVerified(bytes32)\":{\"notice\":\"Returns true if this inferenceId has already been bridged.\"},\"verifyAndBridge(bytes,uint256[],bytes32,bytes32)\":{\"notice\":\"Verify an EZKL Halo2 proof and relay the result to StarkNet.\"}},\"notice\":\"Verifies an EZKL Halo2 proof via the deployed Halo2Verifier, then         relays the result to InferenceVerifier.cairo on StarkNet via the         canonical L1\\u2192L2 messaging contract.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/InferenceBridge.sol\":\"InferenceBridge\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\"